---
layout: layouts/base.njk
---
<article class="post">
  {% if image %}
  <figure class="post-hero">
    <img src="{{ image }}" alt="{{ imageAlt if imageAlt else title }}" />
    {% if imageCaption %}<figcaption>{{ imageCaption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    <time class="post-meta" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
  </header>

  <div class="post-body">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <a href="/" class="back-link">&larr; all essays</a>
  </footer>
</article>
