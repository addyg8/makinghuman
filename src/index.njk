---
layout: layouts/base.njk
title: makinghuman
---
<div class="index-header">
  <h1>essays on science, nature, and what it means to be human</h1>
</div>

<ul class="post-list">
  {% set posts = collections.post | reverse %}
  {% for post in posts %}
  <li>
    <a href="{{ post.url }}">
      <span class="post-list-title">{{ post.data.title }}</span>
      <span class="post-list-date">{{ post.date | readableDate }}</span>
    </a>
  </li>
  {% endfor %}
</ul>
